# Database connection — pick ONE style. The lab only ever reads
# (connections are forced read-only), so app credentials are safe to reuse.

# Style 1: single URL (takes precedence if set)
# DATABASE_URL=postgresql://jinvalex_user:change-me@localhost:5432/jinvalex_database

# Style 2: individual vars (same names as the main project's .env)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jinvalex_database
DB_USER=jinvalex_user
DB_PASSWORD=change-me
